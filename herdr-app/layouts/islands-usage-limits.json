{
  "id": "root",
  "cloned_from": {
    "name": "islands",
    "version": "0.1.14"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "islands-workspace-chrome"
          },
          "size": {
            "px": 32
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14,
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "islands-spaces",
                "props": {
                  "branch_pill": false
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "islands-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            }
          ],
          "gap": 12
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "islands-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 72
          },
          "hidden": true,
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14
        }
      ],
      "size": {
        "px": 44
      },
      "min": 44,
      "max": 480,
      "gap": 12,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "top",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "islands-tabs",
                "props": {
                  "part": "tabs",
                  "joined": true
                }
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "id": "tab-actions",
              "type": "block",
              "content": {
                "mod": "islands-tabs",
                "props": {
                  "part": "actions"
                }
              },
              "size": {
                "px": 191
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 32
          },
          "gap": 12,
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "islands-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#0d0f13f2",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 14,
                  "gap": 12,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 12
        },
        {
          "id": "bottom",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "islands-workspace-status"
              },
              "size": {
                "weight": 1
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "tickets",
              "type": "block",
              "content": {
                "mod": "tickets",
                "props": {
                  "slot": true,
                  "restart": 3
                }
              },
              "size": {
                "px": 150
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "usage-limits",
              "type": "block",
              "content": {
                "mod": "usage-limits"
              },
              "size": {
                "px": 320
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "spotify",
              "type": "block",
              "content": {
                "mod": "spotify",
                "props": {
                  "slot": true,
                  "card": "above",
                  "restart": 30
                }
              },
              "size": {
                "px": 220
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            }
          ],
          "size": {
            "px": 32
          },
          "gap": 12,
          "resizable": false
        }
      ],
      "gap": 12,
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/solo.jpeg",
    "fit": "cover"
  },
  "padding": 12,
  "theme": {
    "light": "paper",
    "dark": "slate-dark"
  },
  "terminal_padding": [
    16,
    14
  ],
  "terminal_opacity": 0,
  "gap": 12,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/islands.svg"
}
