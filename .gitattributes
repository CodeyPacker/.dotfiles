# Shell scripts that Git runs must keep LF line endings on Windows too.
.githooks/* text eol=lf
herdr-app/sync-config.sh text eol=lf
# Herdr writes LF. Keeping LF here lets the sync script compare the files exactly.
herdr-app/keys.json text eol=lf
herdr-app/hints.json text eol=lf
herdr-app/settings.json text eol=lf
herdr-app/mods/islands-workspace-chrome/settings.json text eol=lf
herdr-app/shared.json text eol=lf
