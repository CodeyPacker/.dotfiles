#gitignore

# Machine-local chezmoi data and runtime logs
home/dot_gitconfig
nvim.log

#brew
Brewfile.lock.json

#JetBrains
.DS_Store

#Neovim
nvim/lazy-lock.jso
.nvimlog

# Herdr runtime state
herdr/.plugins.lock
herdr/*.log
herdr/session.json
herdr/sessions/
herdr/picker/*.exe

# VS Code extension build output
vscode/harpoon/node_modules/
vscode/harpoon/out/
vscode/harpoon/*.vsix

# Herdr app rewrites its shipped themes on every start.
herdr-app/themes/atom-one-dark.json
herdr-app/themes/win98.json

# Herdr app layout runtime state and backups.
herdr-app/layouts/.state/
herdr-app/layouts/*.bak*

# Herdr writes these into every mod folder for editor completions
theme/herdr-mod/gpui-kit.d.ts
theme/herdr-mod/jsconfig.json
ai/skills/herdr-background/herdr-mod/gpui-kit.d.ts
ai/skills/herdr-background/herdr-mod/herdr.d.ts
ai/skills/herdr-background/herdr-mod/jsconfig.json
