#!/bin/sh
# After a pull, copy the Herdr app settings files the pull changed into the app.
# Only changed files are copied, so unsaved app edits to the other files are left alone.
# Keep the file list in step with herdr-app/sync-config.sh and sync-config.ps1.

root=$(git rev-parse --show-toplevel)
changed=$(git diff --name-only ORIG_HEAD HEAD -- \
  herdr-app/keys.json \
  herdr-app/hints.json \
  herdr-app/settings.json \
  herdr-app/mods/islands-workspace-chrome/settings.json | sed 's|^herdr-app/||')

if [ -z "$changed" ]; then
  exit 0
fi

# $changed is left unquoted on purpose: each file name is its own argument.
case "$(uname -s)" in
  MINGW* | MSYS*) pwsh -NoProfile -File "$root/herdr-app/sync-config.ps1" pull $changed ;;
  *) "$root/herdr-app/sync-config.sh" pull $changed ;;
esac
